# Copy to .env.local for the intended environment. Never commit real values.
# NEXT_PUBLIC_* values are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: only scripts/provision-staff.mjs uses this privileged key, never the app.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: server-only technical identity for password-only owner login.
GYM_OWNER_LOGIN_EMAIL=

# Server-only Web Push configuration; never use NEXT_PUBLIC_ for private keys.
# Dedicated notifier Auth user, admin app_metadata flag, NO staff row.
SHELBY_NOTIFICATION_WORKER_EMAIL=
SHELBY_NOTIFICATION_WORKER_PASSWORD=
SHELBY_VAPID_PUBLIC_KEY=
SHELBY_VAPID_PRIVATE_KEY=
SHELBY_VAPID_SUBJECT=
